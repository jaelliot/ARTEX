#!/usr/bin/env bash
set -euo pipefail
if (( EUID != 0 )); then
  echo "Run this installer as root inside the ARTEX VM." >&2
  exit 1
fi
root=$(cd "$(dirname "$0")" && pwd)
if ! getent group artex-worker >/dev/null; then
  groupadd --system artex-worker
fi
install -d -o root -g root -m 0755 /opt/artex-worker
install -o root -g root -m 0644 "$root/worker_broker.py" /opt/artex-worker/
install -o root -g root -m 0755 "$root/offline-worker" "$root/cleanup-offline-workers" /opt/artex-worker/
install -o root -g root -m 0644 "$root/artex-worker.service" /etc/systemd/system/
systemctl daemon-reload
echo "Installed the broker without starting it. Verify its socket mount and client group before activation."
