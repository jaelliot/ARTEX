#!/usr/bin/env bash
set -euo pipefail

# Manual worker prototype. ARTEX does not dispatch its tools here yet.
image=${ARTEX_OFFLINE_WORKER_IMAGE:-golang:1.25.8-bookworm}
name="artex-offline-worker-$(date +%s)-$$"
created=0
cleanup() {
  if (( created )); then timeout 15 docker rm -f "$name" >/dev/null 2>&1 || true; fi
}
trap cleanup EXIT

volumes=$(timeout 15 docker image inspect -f '{{len .Config.Volumes}}' "$image")
if [[ $volumes != 0 ]]; then
  echo "Worker image must not declare writable volumes" >&2
  exit 1
fi

timeout 30 docker create --pull never --name "$name" -i --network none --read-only \
  --user 65534:65534 --cap-drop ALL --security-opt no-new-privileges \
  --security-opt apparmor=docker-default --security-opt seccomp=builtin \
  --memory 512m --memory-swap 512m --cpus 1 --pids-limit 64 --shm-size 16m \
  --ulimit nofile=256:256 --ulimit fsize=67108864:67108864 --ulimit core=0:0 --log-driver none \
  --tmpfs /work:rw,nosuid,nodev,noexec,size=128m,uid=65534,gid=65534,mode=700 \
  --tmpfs /tmp:rw,nosuid,nodev,noexec,size=32m,uid=65534,gid=65534,mode=700 \
  --workdir /work --entrypoint /usr/bin/env "$image" -i \
  PATH=/usr/local/bin:/usr/bin:/bin HOME=/work TMPDIR=/tmp /bin/sh -s >/dev/null
created=1

set +e
timeout 120 docker start -a -i "$name" 2>&1 | head -c 1048576
statuses=("${PIPESTATUS[@]}")
set -e
if (( statuses[0] != 0 || statuses[1] != 0 )); then
  echo >&2
  echo "Worker failed, timed out, or exceeded its output limit" >&2
  exit 1
fi
