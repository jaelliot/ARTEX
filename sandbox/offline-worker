#!/usr/bin/env bash
set -euo pipefail

# Worker prototype for manual use and experimental broker dispatch.
image=${ARTEX_OFFLINE_WORKER_IMAGE:-golang:1.25.8-bookworm}
name="artex-offline-worker-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
created=0
cleanup() {
  if (( created )); then
    if ! timeout --foreground --kill-after=5 15 docker rm -f "$name" >/dev/null 2>&1; then
      echo "Worker cleanup could not be verified; stop accepting jobs and inspect Docker." >&2
      exit 125
    fi
  fi
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

image_id=$(timeout --foreground --kill-after=5 15 docker image inspect -f '{{.Id}}' "$image")
volumes=$(timeout --foreground --kill-after=5 15 docker image inspect -f '{{len .Config.Volumes}}' "$image_id")
if [[ $volumes != 0 ]]; then
  echo "Worker image must not declare writable volumes" >&2
  exit 1
fi
if timeout --foreground --kill-after=5 15 docker inspect "$name" >/dev/null 2>&1; then
  echo "Worker container name already exists" >&2
  exit 1
fi
created=1

timeout --foreground --kill-after=5 30 docker create --pull never --name "$name" -i --network none --read-only \
  --label com.artex.worker=offline \
  --user 65534:65534 --cap-drop ALL --security-opt no-new-privileges \
  --security-opt apparmor=docker-default --security-opt seccomp=builtin \
  --memory 512m --memory-swap 512m --cpus 1 --pids-limit 64 --shm-size 16m \
  --ulimit nofile=256:256 --ulimit fsize=67108864:67108864 --ulimit core=0:0 --log-driver none \
  --tmpfs /work:rw,nosuid,nodev,noexec,size=128m,uid=65534,gid=65534,mode=700 \
  --tmpfs /tmp:rw,nosuid,nodev,noexec,size=32m,uid=65534,gid=65534,mode=700 \
  --workdir /work --entrypoint /usr/bin/env "$image_id" -i \
  PATH=/usr/local/bin:/usr/bin:/bin HOME=/work TMPDIR=/tmp /bin/bash -s >/dev/null

set +e
timeout --foreground --kill-after=5 120 docker start -a -i "$name" 2>&1 | head -c 1048576
statuses=("${PIPESTATUS[@]}")
set -e
if (( statuses[0] != 0 || statuses[1] != 0 )); then
  echo >&2
  echo "Worker failed, timed out, or exceeded its output limit" >&2
  exit 1
fi
