#!/usr/bin/env bash
set -euo pipefail

image=${ARTEX_OFFLINE_POSTGRES_IMAGE:-postgres:16-alpine}
name="artex-postgres-fixture-$(date +%s)-$$"
created=0
cleanup() {
  if (( created )); then timeout 15 docker rm -f "$name" >/dev/null 2>&1 || true; fi
}
trap cleanup EXIT

timeout 30 docker run -d --pull never --name "$name" --network none --read-only \
  --user 70:70 --cap-drop ALL --security-opt no-new-privileges \
  --security-opt apparmor=docker-default --security-opt seccomp=builtin \
  --memory 256m --memory-swap 256m --cpus 1 --pids-limit 64 --shm-size 8m \
  --ulimit nofile=256:256 --ulimit fsize=67108864:67108864 --ulimit core=0:0 \
  --log-opt max-size=1m --log-opt max-file=1 \
  --tmpfs /var/lib/postgresql/data:rw,nosuid,nodev,noexec,size=128m,uid=70,gid=70,mode=700 \
  --tmpfs /var/run/postgresql:rw,nosuid,nodev,noexec,size=4m,uid=70,gid=70,mode=775 \
  --tmpfs /tmp:rw,nosuid,nodev,noexec,size=8m,uid=70,gid=70,mode=700 \
  --entrypoint /usr/bin/env "$image" -i \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  HOME=/tmp TMPDIR=/tmp PGDATA=/var/lib/postgresql/data \
  POSTGRES_USER=fixture POSTGRES_PASSWORD=fixture POSTGRES_DB=fixture \
  /usr/local/bin/docker-entrypoint.sh postgres >/dev/null
created=1

ready=0
for attempt in {1..15}; do
  if timeout 5 docker exec "$name" pg_isready -q -h /var/run/postgresql -U fixture -d fixture; then
    ready=1
    break
  fi
  sleep 1
done
if (( ! ready )); then
  timeout 10 docker logs "$name" 2>&1 | tail -25
  exit 1
fi
result=$(timeout 10 docker exec "$name" psql -h /var/run/postgresql -U fixture -d fixture -Atqc 'select 1')
[[ $result == 1 ]]
echo "Offline PostgreSQL controls verified"
